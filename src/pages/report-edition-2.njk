---
layout: base.njk
navActive: reports
pagination:
  data: languages.list
  size: 1
  alias: lang
permalink: "{% if lang == 'en' %}/reports/edition-2/index.html{% else %}/{{ lang }}/reports/edition-2/index.html{% endif %}"
---
{% set t = i18n[lang] %}
{% set langPrefix = "" if lang == "en" else "/" + lang %}
{% set report = null %}
{% for post in posts %}
  {% if post.slug == "state-of-sport-in-africa-edition-2" %}
    {% set report = post %}
  {% endif %}
{% endfor %}
{% set loc = report.i18n[lang] or {} %}

<section class="circuit-bg--subtle page-hero" aria-labelledby="page-title">
  <div class="container">
    <div class="hero-inner" style="min-height:unset;padding:40px 0 32px;">
      <a href="{{ langPrefix }}/reports/" style="font-size:13px;color:var(--text-muted);text-decoration:none;">{{ t.reports.back_to_reports }}</a>
      <h1 class="hero-title" id="page-title" style="font-size:clamp(24px,4vw,40px);margin-top:12px;">{{ loc.title or report.title }}</h1>
      <p class="hero-sub" style="font-size:17px;">{{ loc.excerpt or report.excerpt }}</p>
    </div>
  </div>
</section>

<section class="section section--white">
  <div class="container">
    <div class="text-visual reveal" style="align-items:flex-start;">

      {# ── LEFT: about + key figures + download ── #}
      <div>
        <span class="eyebrow">{{ t.reports.about_heading }}</span>
        <h2 class="section-title">{{ loc.title or report.title }}</h2>
        <div class="section-divider"></div>
        <p style="font-size:15px;color:var(--text-secondary);line-height:1.85;margin-bottom:16px;">
          Building on Edition 1, this report expands the AfricanSTN registry to over 7,000 organisations spanning 56 countries and 81 sports. It profiles the 95 identified sports tech startups, examines the ecosystem support landscape, and draws lessons from companies that have ceased operations.
        </p>

        {# ── Key figures ── #}
        <h3 style="font-size:14px;text-transform:uppercase;letter-spacing:0.06em;color:var(--accent-gold);margin:24px 0 12px;">{{ t.reports.key_figures_heading }}</h3>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:12px;margin-bottom:24px;">
          <div class="card card--gold-top" style="padding:16px;text-align:center;">
            <span style="font-size:28px;font-weight:700;color:var(--accent-gold);display:block;">7,000+</span>
            <span style="font-size:12px;color:var(--text-muted);">Organisations</span>
          </div>
          <div class="card card--gold-top" style="padding:16px;text-align:center;">
            <span style="font-size:28px;font-weight:700;color:var(--accent-gold);display:block;">95</span>
            <span style="font-size:12px;color:var(--text-muted);">Sports tech startups</span>
          </div>
          <div class="card card--gold-top" style="padding:16px;text-align:center;">
            <span style="font-size:28px;font-weight:700;color:var(--accent-gold);display:block;">56</span>
            <span style="font-size:12px;color:var(--text-muted);">Countries</span>
          </div>
          <div class="card card--gold-top" style="padding:16px;text-align:center;">
            <span style="font-size:28px;font-weight:700;color:var(--accent-gold);display:block;">81</span>
            <span style="font-size:12px;color:var(--text-muted);">Sports covered</span>
          </div>
        </div>

        <p style="font-size:13px;color:var(--text-muted);margin-bottom:24px;">Published: {{ report.date }}</p>

        {% if report.download %}
          <a href="{{ report.download }}" download target="_blank" rel="noopener" class="btn btn-primary">{{ t.reports.download_cta }} →</a>
        {% endif %}
      </div>

      {# ── RIGHT: cover image ── #}
      <div style="flex-shrink:0;">
        {% if report.image %}
          <img src="{{ report.image }}" alt="{{ loc.title or report.title }}" style="width:100%;max-width:380px;border-radius:8px;box-shadow:0 8px 32px rgba(0,0,0,.12);" loading="lazy">
        {% endif %}
      </div>

    </div>
  </div>
</section>

{# ── CTA ── #}
<section class="section circuit-bg section--circuit">
  <div class="container" style="text-align:center;">
    <div class="reveal">
      <span class="eyebrow">{{ t.reports.cta_eyebrow }}</span>
      <h2 class="section-title section-title--white" style="max-width:560px;margin:0 auto 16px;">{{ t.reports.cta_heading }}</h2>
      <p class="section-lead section-lead--dark" style="margin:0 auto 36px;max-width:540px;">{{ t.reports.cta_body }}</p>
      <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
        <a href="{{ langPrefix }}/join/" class="btn btn-primary">{{ t.reports.register_interest }}</a>
        <a href="{{ langPrefix }}/contact/" class="btn btn-outline">{{ t.reports.contact_us }}</a>
      </div>
    </div>
  </div>
</section>
