---
layout: base.njk
navActive: reports
pagination:
  data: languages.list
  size: 1
  alias: lang
permalink: "{% if lang == 'en' %}/reports/index.html{% else %}/{{ lang }}/reports/index.html{% endif %}"
---
{% set t = i18n[lang] %}
{% set langPrefix = "" if lang == "en" else "/" + lang %}

<section class="circuit-bg--subtle page-hero" aria-labelledby="page-title">
  <div class="container">
    <div class="hero-inner" style="min-height:unset;padding:40px 0 32px;">
      <span class="eyebrow">{{ t.reports.hero_eyebrow }}</span>
      <h1 class="hero-title" id="page-title" style="font-size:clamp(28px,4.5vw,48px);">{{ t.reports.hero_heading }}</h1>
      <p class="hero-sub" style="font-size:17px;">{{ t.reports.hero_subheading }}</p>
    </div>
  </div>
</section>

{# ── REPORT CARDS ── #}
<section class="section section--white" aria-labelledby="editions-heading">
  <div class="container">
    <div class="reveal">
      <span class="eyebrow">{{ t.reports.all_editions_heading }}</span>
      <h2 class="section-title" id="editions-heading">{{ t.reports.all_editions_heading }}</h2>
      <div class="section-divider"></div>

      {% set reportItems = [] %}
      {% for post in posts %}
        {% if post.category == "Industry report" %}
          {% set reportItems = (reportItems.push(post), reportItems) %}
        {% endif %}
      {% endfor %}

      {% if reportItems.length > 0 %}
        <div class="grid-2" style="gap:24px;margin-top:32px;">
          {% for post in reportItems | reverse %}
            {% set loc = post.i18n[lang] or {} %}
            <article class="card card--gold-top" style="padding:0;overflow:hidden;">
              {% if post.image %}
                <a href="{{ langPrefix }}/reports/{{ post.slug | replace('state-of-sport-in-africa-', '') }}/">
                  <img src="{{ post.image }}" alt="{{ loc.title or post.title }}" style="width:100%;height:auto;display:block;" loading="lazy">
                </a>
              {% endif %}
              <div style="padding:24px;">
                <p style="font-size:12px;color:var(--text-muted);margin-bottom:8px;">{{ post.date }}</p>
                <h3 style="font-size:16px;margin-bottom:10px;">{{ loc.title or post.title }}</h3>
                <p>{{ loc.excerpt or post.excerpt }}</p>
                <div style="display:flex;gap:16px;align-items:center;margin-top:16px;flex-wrap:wrap;">
                  <a href="{{ langPrefix }}/reports/{{ post.slug | replace('state-of-sport-in-africa-', '') }}/" style="font-size:14px;font-weight:600;color:var(--accent-gold);">{{ t.reports.view_report }}</a>
                  {% if post.download %}
                    <a href="{{ post.download }}" download target="_blank" rel="noopener" style="font-size:14px;font-weight:600;color:var(--text-muted);">{{ t.reports.download_report }}</a>
                  {% endif %}
                </div>
              </div>
            </article>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{# ── CTA ── #}
<section class="section circuit-bg section--circuit">
  <div class="container" style="text-align:center;">
    <div class="reveal">
      <span class="eyebrow">{{ t.reports.cta_eyebrow }}</span>
      <h2 class="section-title section-title--white" style="max-width:560px;margin:0 auto 16px;">{{ t.reports.cta_heading }}</h2>
      <p class="section-lead section-lead--dark" style="margin:0 auto 36px;max-width:540px;">{{ t.reports.cta_body }}</p>
      <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
        <a href="{{ langPrefix }}/join/" class="btn btn-primary">{{ t.reports.register_interest }}</a>
        <a href="{{ langPrefix }}/contact/" class="btn btn-outline">{{ t.reports.contact_us }}</a>
      </div>
    </div>
  </div>
</section>
