---
layout: base.njk
navActive: services
pagination:
  data: languages.list
  size: 1
  alias: lang
permalink: "{% if lang == 'en' %}/services/index.html{% else %}/{{ lang }}/services/index.html{% endif %}"
---
{% set t = i18n[lang] %}
{% set langPrefix = "" if lang == "en" else "/" + lang %}
{% set c = t.conv or i18n.en.conv %}

<section class="circuit-bg--subtle page-hero" aria-labelledby="page-title">
  <div class="container">
    <div class="hero-inner" style="min-height:unset;padding:40px 0 32px;">
      <span class="eyebrow">{{ t.services.eyebrow_what }}</span>
      <h1 class="hero-title" id="page-title" style="font-size:clamp(28px,4.5vw,48px);">{{ t.services.hero_heading }}</h1>
      <p class="hero-sub" style="font-size:17px;">{{ c.hero_sub }}</p>
    </div>
  </div>
</section>

{% include "partials/proof-strip.njk" %}

<!-- Market access -->
<section class="section section--white" aria-labelledby="ma-title">
  <div class="container">
    <div class="text-visual reveal" style="align-items:flex-start;">
      <div>
        <span class="eyebrow">{{ t.home.card1_title }}</span>
        <h2 class="section-title" id="ma-title">{{ c.ma_heading }}</h2>
        <div class="section-divider"></div>
        <p style="font-size:15px;color:var(--text-secondary);line-height:1.8;margin-bottom:28px;">{{ t.home.card1_body }}</p>
        <a href="mailto:hello@stza.io?subject={{ c.ma_subject | urlencode }}" class="btn btn-primary">{{ c.ma_cta }}</a>
      </div>
      <div style="display:flex;flex-direction:column;gap:14px;">
        <div class="feature-band"><div class="feature-band-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C5A059" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div><div><h4>{{ c.ma_item1_title }}</h4><p>{{ c.ma_item1_body }}</p></div></div>
        <div class="feature-band"><div class="feature-band-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C5A059" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"/></svg></div><div><h4>{{ c.ma_item2_title }}</h4><p>{{ c.ma_item2_body }}</p></div></div>
        <div class="feature-band"><div class="feature-band-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C5A059" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></div><div><h4>{{ c.ma_item3_title }}</h4><p>{{ c.ma_item3_body }}</p></div></div>
      </div>
    </div>
  </div>
</section>

<section class="section section--warm">
  <div class="container">
    <div class="text-visual text-visual--flip reveal">
      <div>
        <span class="eyebrow">{{ t.services.intel_eyebrow }}</span>
        <h2 class="section-title">{{ t.services.intel_heading }}</h2>
        <div class="section-divider"></div>
        <p style="font-size:15px;color:var(--text-secondary);line-height:1.8;margin-bottom:16px;">{{ t.services.intel_para1 }}</p>
        <p style="font-size:15px;color:var(--text-secondary);line-height:1.8;margin-bottom:28px;">{{ t.services.intel_para2 }}</p>
        <a href="{{ langPrefix }}/join/" class="btn btn-outline-gold">{{ c.intel_cta }}</a>
      </div>
      <div class="grid-2" style="gap:16px;">
        <div class="card card--gold-top" style="padding:20px;"><h3 style="font-size:15px;">{{ t.services.intel_card1_title }}</h3><p>{{ t.services.intel_card1_body }}</p></div>
        <div class="card card--gold-top" style="padding:20px;"><h3 style="font-size:15px;">{{ t.services.intel_card2_title }}</h3><p>{{ t.services.intel_card2_body }}</p></div>
        <div class="card card--gold-top" style="padding:20px;"><h3 style="font-size:15px;">{{ t.services.intel_card3_title }}</h3><p>{{ t.services.intel_card3_body }}</p></div>
        <div class="card card--gold-top" style="padding:20px;"><h3 style="font-size:15px;">{{ t.services.intel_card4_title }}</h3><p>{{ t.services.intel_card4_body }}</p></div>
      </div>
    </div>
  </div>
</section>

<section class="section section--white">
  <div class="container">
    <div class="text-visual reveal">
      <div>
        <span class="eyebrow">{{ t.services.popia_eyebrow }}</span>
        <h2 class="section-title">{{ t.services.popia_heading }}</h2>
        <div class="section-divider"></div>
        <p style="font-size:15px;color:var(--text-secondary);line-height:1.8;margin-bottom:16px;">{{ t.services.popia_para1 }}</p>
        <p style="font-size:15px;color:var(--text-secondary);line-height:1.8;margin-bottom:28px;">{{ t.services.popia_para2 }}</p>
        <div class="tag-row">
          <span class="tag">{{ t.services.tag1 }}</span>
          <span class="tag">{{ t.services.tag2 }}</span>
          <span class="tag">{{ t.services.tag3 }}</span>
          <span class="tag">{{ t.services.tag4 }}</span>
        </div>
        <div class="notice" style="margin-top:20px;">{{ t.services.popia_notice }}</div>
        <a href="mailto:hello@stza.io?subject={{ c.popia_subject | urlencode }}" class="btn btn-primary" style="margin-top:24px;">{{ t.services.popia_cta }}</a>
        <p style="font-size:13px;color:var(--text-muted);margin-top:10px;">{{ c.popia_email_note }} <a href="mailto:hello@stza.io">hello@stza.io</a></p>
      </div>
      <div>
        <div class="feature-band"><div class="feature-band-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C5A059" stroke-width="1.8" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></div><div><h4>{{ t.services.feature1_title }}</h4><p>{{ t.services.feature1_body }}</p></div></div>
        <div class="feature-band"><div class="feature-band-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C5A059" stroke-width="1.8" stroke-linecap="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></div><div><h4>{{ t.services.feature2_title }}</h4><p>{{ t.services.feature2_body }}</p></div></div>
        <div class="feature-band"><div class="feature-band-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C5A059" stroke-width="1.8" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div><div><h4>{{ t.services.feature3_title }}</h4><p>{{ t.services.feature3_body }}</p></div></div>
        <div class="feature-band"><div class="feature-band-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C5A059" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></div><div><h4>{{ t.services.feature4_title }}</h4><p>{{ t.services.feature4_body }}</p></div></div>
      </div>
    </div>
  </div>
</section>

<!-- POPIA: how it works -->
<section class="section section--warm" aria-labelledby="how-title">
  <div class="container">
    <div class="section-header section-header--center reveal">
      <span class="eyebrow">{{ c.how_eyebrow }}</span>
      <h2 class="section-title" id="how-title">{{ c.how_heading }}</h2>
      <div class="section-divider section-divider--center"></div>
    </div>
    <ol class="how-steps reveal" role="list">
      <li class="card card--gold-top"><span class="how-steps__num" aria-hidden="true">1</span><h3>{{ c.step1_title }}</h3><p>{{ c.step1_body }}</p></li>
      <li class="card card--gold-top"><span class="how-steps__num" aria-hidden="true">2</span><h3>{{ c.step2_title }}</h3><p>{{ c.step2_body }}</p></li>
      <li class="card card--gold-top"><span class="how-steps__num" aria-hidden="true">3</span><h3>{{ c.step3_title }}</h3><p>{{ c.step3_body }}</p></li>
    </ol>
    <div style="text-align:center;margin-top:32px;">
      <a href="mailto:hello@stza.io?subject={{ c.popia_subject | urlencode }}" class="btn btn-primary">{{ c.cta_popia_btn }}</a>
    </div>
  </div>
</section>

<section class="section circuit-bg section--circuit">
  <div class="container" style="text-align:center;">
    <div class="reveal">
      <span class="eyebrow">{{ t.services.cta_eyebrow }}</span>
      <h2 class="section-title section-title--white" style="max-width:560px;margin:0 auto 16px;">{{ t.services.cta_heading }}</h2>
      <p class="section-lead section-lead--dark" style="margin:0 auto 36px;max-width:540px;">{{ t.services.cta_body }}</p>
      <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
        <a href="mailto:hello@stza.io?subject={{ c.popia_subject | urlencode }}" class="btn btn-primary">{{ c.cta_popia_btn }}</a>
        <a href="{{ langPrefix }}/join/" class="btn btn-outline">{{ c.intel_cta }}</a>
      </div>
    </div>
  </div>
</section>
